# Google Cloud / Vertex AI & Firestore Admin SDK
# On App Engine / Cloud Run, ADC is provided automatically.
# Locally, run `gcloud auth application-default login` or set GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_AI_MODEL=gemini-4-neon

# Optional: inline Firebase service account JSON (for environments without GCP ADC)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# SMTP Email Delivery (e.g., Gmail App Password)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional custom SMTP overrides:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM="Revisionist <your-email@gmail.com>"

# Gumroad Licensing
GUMROAD_PRODUCT_ID=your-gumroad-product-id
GUMROAD_ACCESS_TOKEN=your-gumroad-access-token
# Optional internal bypass key for testing:
# MASTER_LICENSE_KEY=

# Optional Public Site Overrides
# NEXT_PUBLIC_SUPPORT_EMAIL=roseman.jake@gmail.com
# NEXT_PUBLIC_SITE_URL=https://revisionist.ai
# NEXT_PUBLIC_CANONICAL_URL=https://www.revisionistai.com
# NEXT_PUBLIC_GUMROAD_PRODUCT_URL=https://8485562534997.gumroad.com/l/revisionist
